# name: tests/sql/metadata_visibility.test
# description: verify metadata visibility for user-created table and view
# group: [sql]

statement ok
DROP VIEW IF EXISTS metadata_sql_view

statement ok
DROP TABLE IF EXISTS metadata_sql_table

statement ok
CREATE TABLE metadata_sql_table (id INTEGER, name VARCHAR)

statement ok
INSERT INTO metadata_sql_table VALUES (1, 'one'), (2, 'two')

statement ok
CREATE VIEW metadata_sql_view AS SELECT id, name FROM metadata_sql_table

query TT
SELECT table_name, table_type
FROM information_schema.tables
WHERE table_name IN ('metadata_sql_table', 'metadata_sql_view')
ORDER BY table_name
----
metadata_sql_table	BASE TABLE
metadata_sql_view	VIEW

statement ok
DROP VIEW metadata_sql_view

statement ok
DROP TABLE metadata_sql_table


# --- temp table visibility ---

statement ok
DROP TABLE IF EXISTS meta_temp_tbl

statement ok
CREATE TEMP TABLE meta_temp_tbl (id INTEGER, val VARCHAR)

statement ok
INSERT INTO meta_temp_tbl VALUES (1, 'temp_one'), (2, 'temp_two')

query II
SELECT id, val FROM meta_temp_tbl ORDER BY id
----
1	temp_one
2	temp_two

# temp table should appear in information_schema with type LOCAL TEMPORARY
# (table_schema varies by DuckDB version: 'temp' or 'main'; check table_type only)
query TT
SELECT table_name, table_type
FROM information_schema.tables
WHERE table_name = 'meta_temp_tbl'
  AND table_type = 'LOCAL TEMPORARY'
ORDER BY table_name
----
meta_temp_tbl	LOCAL TEMPORARY


# --- same-name temp and permanent tables ---

statement ok
DROP TABLE IF EXISTS meta_dual

statement ok
CREATE TABLE meta_dual (id INTEGER, val VARCHAR)

statement ok
INSERT INTO meta_dual VALUES (10, 'perm')

statement ok
CREATE TEMP TABLE meta_dual (id INTEGER, val VARCHAR)

statement ok
INSERT INTO meta_dual VALUES (20, 'temp')

# both temp and permanent should appear in information_schema
query TT
SELECT table_name, table_type
FROM information_schema.tables
WHERE table_name = 'meta_dual'
ORDER BY table_type
----
meta_dual	BASE TABLE
meta_dual	LOCAL TEMPORARY

# unqualified SELECT resolves to temp (shadows permanent)
query II
SELECT id, val FROM meta_dual ORDER BY id
----
20	temp

# schema-qualified name reaches permanent table
query II
SELECT id, val FROM main.meta_dual ORDER BY id
----
10	perm

# schema-qualified name for temp table via pg_temp (SQL-standard alias)
query II
SELECT id, val FROM pg_temp.meta_dual ORDER BY id
----
20	temp


# --- info_schema: verify distinct types for same-name tables ---

query I
SELECT COUNT(*) FROM information_schema.tables
WHERE table_name = 'meta_dual'
----
2

query TT
SELECT table_name, table_type
FROM information_schema.tables
WHERE table_name = 'meta_dual'
  AND table_type = 'BASE TABLE'
----
meta_dual	BASE TABLE

query TT
SELECT table_name, table_type
FROM information_schema.tables
WHERE table_name = 'meta_dual'
  AND table_type = 'LOCAL TEMPORARY'
----
meta_dual	LOCAL TEMPORARY


# --- cleanup ---

statement ok
DROP TABLE IF EXISTS meta_temp_tbl

statement ok
DROP TABLE IF EXISTS pg_temp.meta_dual

statement ok
DROP TABLE IF EXISTS meta_dual
